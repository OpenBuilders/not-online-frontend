---
interface Props {
  title: string;
  description?: string;
  favicon?: string;
  backdrop?: string;
  bodyStyle?: string;
}

const { title, description = 'A page on not.online', favicon, backdrop, bodyStyle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    {favicon ? (
      <link rel="icon" href={favicon} />
    ) : (
      <>
        <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16x16.png" />
        <link rel="icon" href="/assets/favicons/favicon.ico" sizes="48x48" />
        <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon.png" />
        <link rel="manifest" href="/assets/favicons/site.webmanifest" />
      </>
    )}
    <meta name="theme-color" content="#1c1c1e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block" rel="stylesheet" />
    <title>{title}</title>
    <style is:global>
      body {
        margin: 0;
        padding: 0;
        background-color: var(--page-bg);
      }
      body[data-backdrop='grid'] {
        background-image:
          linear-gradient(to right, color-mix(in srgb, var(--page-ink) 14%, transparent) 1px, transparent 1px),
          linear-gradient(to bottom, color-mix(in srgb, var(--page-ink) 14%, transparent) 1px, transparent 1px);
        background-size: 32px 32px;
      }
      body[data-backdrop='dots'] {
        background-image: radial-gradient(color-mix(in srgb, var(--page-ink) 22%, transparent) 1.6px, transparent 1.7px);
        background-size: 18px 18px;
      }
      body[data-backdrop='rays'] {
        background-image: repeating-conic-gradient(
          from 0deg at 50% 32%,
          color-mix(in srgb, var(--page-accent) 22%, transparent) 0deg 9deg,
          transparent 9deg 18deg
        );
      }
      body[data-backdrop='checker'] {
        background-image:
          linear-gradient(45deg, color-mix(in srgb, var(--page-ink) 10%, transparent) 25%, transparent 25% 75%, color-mix(in srgb, var(--page-ink) 10%, transparent) 75%),
          linear-gradient(45deg, color-mix(in srgb, var(--page-ink) 10%, transparent) 25%, transparent 25% 75%, color-mix(in srgb, var(--page-ink) 10%, transparent) 75%);
        background-size: 56px 56px;
        background-position: 0 0, 28px 28px;
      }
      body[data-backdrop='stripes'] {
        background-image: repeating-linear-gradient(-45deg, color-mix(in srgb, var(--page-accent) 20%, transparent) 0 14px, transparent 14px 34px);
      }
      body[data-backdrop='photo'] {
        background-image:
          linear-gradient(
            color-mix(in srgb, var(--page-bg) 55%, transparent),
            color-mix(in srgb, var(--page-bg) 55%, transparent)
          ),
          var(--page-photo);
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
      }
    </style>
  </head>
  <body data-backdrop={backdrop} style={bodyStyle}>
    <slot />
  </body>
</html>
