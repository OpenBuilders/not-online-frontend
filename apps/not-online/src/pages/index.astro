---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="not.online">
  <main><h1>not.online</h1><p>Every link, in one place.</p></main>
</BaseLayout>

<style>
  main { min-height: 100svh; display: grid; place-content: center; padding: 24px; background: #0b0b0c; color: #fff; font-family: Arial, sans-serif; text-align: center; }
  h1 { margin: 0; color: #a8ff1a; font-size: clamp(48px, 11vw, 112px); }
</style>
