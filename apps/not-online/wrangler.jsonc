{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-online",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/assets/*",
      "!/images/*"
    ]
  }
}
