{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-online-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "services": [
    {
      "binding": "TOOLS",
      "service": "not-tools-frontend"
    },
    {
      "binding": "ONLINE",
      "service": "not-online"
    }
  ]
}
