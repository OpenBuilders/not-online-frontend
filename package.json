{
  "name": "not-tools-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:online": "npm --prefix apps/not-online run dev",
    "build": "tsc -b && vite build",
    "stage:online-assets": "node scripts/stage-unified-assets.mjs",
    "build:online": "npm run build && npm run stage:online-assets && npm --prefix apps/not-online run build",
    "build:all": "npm run build:online",
    "deploy": "npm run build:online && npm --prefix apps/not-online run deploy",
    "deploy:tools": "npm run deploy",
    "deploy:online": "npm run deploy",
    "lint": "oxlint",
    "preview": "npm run build:online && npm --prefix apps/not-online run preview",
    "preview:editor": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@plausible-analytics/tracker": "^0.4.6",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
